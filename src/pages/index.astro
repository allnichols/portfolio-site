---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="hero min-h-screen">
    <div class="hero-content text-center pt-0">
      <div class="max-w-md">
        <h1 class="text-2xl font-bold fade-in fade-in-delay">Hello, I'm Max</h1>
        <h1 class="text-4xl font-bold leading-15 pb-5 fade-in fade-in-delay-2">
          Front End Engineer
        </h1>
        <h3 class="mb-8 text-lg fade-in fade-in-delay-2">
          I'm a front-end engineer with a passion for building beautiful and
          functional user interfaces. I have experience with React, Node.js,
          Next.js, and Tailwind CSS.
        </h3>


        <button class="btn btn-primary btn-lg btn-accent mt-2"
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-download-icon lucide-download"
            ><path d="M12 15V3"></path><path
              d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path
              d="m7 10 5 5 5-5"></path></svg
          > Resume
        </button>
      </div>
    </div>
  </div>

  <section id="overview">
    <div class="container mx-auto px-4 py-16">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center mb-12">What I Do</h2>
        
        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div class="text-center">
            <div class="bg-primary text-primary-content rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
              </svg>
            </div>
            <h4 class="text-xl font-semibold mb-2">4+ Years Experience</h4>
            <p class="text-base-content/70">Developing modern web applications with cutting-edge technologies</p>
          </div>
          
          <div class="text-center">
            <div class="bg-secondary text-secondary-content rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 12l2 2 4-4"></path>
                <circle cx="12" cy="12" r="9"></circle>
              </svg>
            </div>
            <h4 class="text-xl font-semibold mb-2">20+ Projects Delivered</h4>
            <p class="text-base-content/70">Successfully launched responsive websites and web applications</p>
          </div>
          
          <div class="text-center">
            <div class="bg-accent text-accent-content rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v20M2 12h20"></path>
              </svg>
            </div>
            <h4 class="text-xl font-semibold mb-2">Full-Stack Ready</h4>
            <p class="text-base-content/70">Frontend expertise with backend knowledge in Node.js and databases</p>
          </div>
        </div>

        <div class="mt-12">
          <h3 class="text-2xl font-bold text-center mb-8">Skills & Technologies</h3>
          <div class="flex flex-wrap justify-center gap-3">
            <span class="badge badge-lg badge-primary">React</span>
            <span class="badge badge-lg badge-primary">Next.js</span>
            <span class="badge badge-lg badge-primary">TypeScript</span>
            <span class="badge badge-lg badge-secondary">Tailwind CSS</span>
            <span class="badge badge-lg badge-secondary">Node.js</span>
            <span class="badge badge-lg badge-secondary">JavaScript</span>
            <span class="badge badge-lg badge-accent">HTML5</span>
            <span class="badge badge-lg badge-accent">CSS3</span>
            <span class="badge badge-lg badge-accent">Git</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="experience">
      <h2>Experience</h2>
      <div class="container mx-auto px-4 py-16">
        <div class="max-w-4xl mx-auto">
          <h2 class="text-3xl font-bold text-center mb-12">Experience</h2>
          
          <div class="space-y-8">
            <div class="card bg-base-100 shadow-xl">
              <div class="card-body">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="card-title text-xl">Senior Frontend Developer</h3>
                  <span class="badge badge-primary">2022 - Present</span>
                </div>
                <p class="text-base-content/70 mb-2">Tech Company Inc.</p>
                <p class="text-sm">Led development of responsive web applications using React and TypeScript. Collaborated with design team to implement pixel-perfect UI components.</p>
              </div>
            </div>

            <div class="card bg-base-100 shadow-xl">
              <div class="card-body">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="card-title text-xl">Frontend Developer</h3>
                  <span class="badge badge-secondary">2020 - 2022</span>
                </div>
                <p class="text-base-content/70 mb-2">Startup Solutions</p>
                <p class="text-sm">Built modern web applications using React, Next.js, and Tailwind CSS. Improved page load times by 40% through optimization techniques.</p>
              </div>
            </div>

            <div class="card bg-base-100 shadow-xl">
              <div class="card-body">
                <div class="flex justify-between items-start mb-2">
                  <h3 class="card-title text-xl">Junior Developer</h3>
                  <span class="badge badge-accent">2019 - 2020</span>
                </div>
                <p class="text-base-content/70 mb-2">Digital Agency</p>
                <p class="text-sm">Developed client websites using HTML, CSS, and JavaScript. Gained experience in responsive design and cross-browser compatibility.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
  </section>
</Layout>
