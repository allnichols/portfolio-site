---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
console.log({ pathname, currentPath });

const isHomePage = currentPath === "";
---

<div class={`dock md:hidden ${isHomePage ? "" : "hidden"}`}>
  <a
    href="#experience"
    class={currentPath === "experience" ? "dock-active" : ""}
  >
    <svg
      class="size-[1.2em]"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      ><g fill="currentColor" stroke-linejoin="miter" stroke-linecap="butt"
        ><polyline
          points="3 14 9 14 9 17 15 17 15 14 21 14"
          fill="none"
          stroke="currentColor"
          stroke-miterlimit="10"
          stroke-width="2"></polyline><rect
          x="3"
          y="3"
          width="18"
          height="18"
          rx="2"
          ry="2"
          fill="none"
          stroke="currentColor"
          stroke-linecap="square"
          stroke-miterlimit="10"
          stroke-width="2"></rect></g
      ></svg
    >
    <span class="dock-label">Experience</span>
  </a>

  <a href="#projects" class={currentPath === "projects" ? "dock-active" : ""}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"
      ></path>
    </svg>

    <span class="dock-label">Projects</span>
  </a>

  <a href="#contact" class={currentPath === "contact" ? "dock-active" : ""}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 1 0-2.636 6.364M16.5 12V8.25"
      ></path>
    </svg>

    <span class="dock-label">Contact</span>
  </a>
</div>

<script>
  // only want this to run once so not wrapping it in an event listener to catch astro:page-load
  const dockEls = document.querySelectorAll(".dock a");
  dockEls.forEach((el, i) => {
    const htmlEl = el as HTMLElement;
    htmlEl.style.opacity = "0";
    htmlEl.style.transform = "translateY(20px)";
    setTimeout(() => {
      htmlEl.style.transition =
        "opacity 0.7s cubic-bezier(0.4,0,0.2,1), transform 0.7s cubic-bezier(0.4,0,0.2,1)";
      htmlEl.style.opacity = "1";
      htmlEl.style.transform = "translateY(0)";
    }, i * 200);
  });

  document.addEventListener("astro:page-load", () => {
    const dockEls = document.querySelectorAll(".dock a");
    dockEls.forEach((el) => {
      el.addEventListener("click", (e) => {
        if (el.classList.contains("dock-active")) {
          e.preventDefault();
        }
      });
    });
  });
</script>
