---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<div class="dock md:hidden">
  <a href="#overview">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0Z"
      ></path>
    </svg>
    <span class="dock-label">About</span>
  </a>
  <a
    href="#experience"
    class={currentPath === "experience" ? "dock-active" : ""}
  >
    <svg
      class="size-[1.2em]"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      ><g fill="currentColor" stroke-linejoin="miter" stroke-linecap="butt"
        ><polyline
          points="3 14 9 14 9 17 15 17 15 14 21 14"
          fill="none"
          stroke="currentColor"
          stroke-miterlimit="10"
          stroke-width="2"></polyline><rect
          x="3"
          y="3"
          width="18"
          height="18"
          rx="2"
          ry="2"
          fill="none"
          stroke="currentColor"
          stroke-linecap="square"
          stroke-miterlimit="10"
          stroke-width="2"></rect></g
      ></svg
    >
    <span class="dock-label">Experience</span>
  </a>

  <a href="#contact" class={currentPath === "projects" ? "dock-active" : ""}>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M16.5 12a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Zm0 0c0 1.657 1.007 3 2.25 3S21 13.657 21 12a9 9 0 1 0-2.636 6.364M16.5 12V8.25"
      ></path>
    </svg>

    <span class="dock-label">Contact</span>
  </a>
</div>

<script>
  // only want this to run once so not wrapping it in an event listener to catch astro:page-load
  const dockEls = document.querySelectorAll(".dock a");
  dockEls.forEach((el, i) => {
    const htmlEl = el as HTMLElement;
    htmlEl.style.opacity = "0";
    htmlEl.style.transform = "translateY(20px)";
    setTimeout(() => {
      htmlEl.style.transition =
        "opacity 0.7s cubic-bezier(0.4,0,0.2,1), transform 0.7s cubic-bezier(0.4,0,0.2,1)";
      htmlEl.style.opacity = "1";
      htmlEl.style.transform = "translateY(0)";
    }, i * 200);
  });

  document.addEventListener("astro:page-load", () => {
    const dockEls = document.querySelectorAll(".dock a");
    dockEls.forEach((el) => {
      el.addEventListener("click", (e) => {
        if (el.classList.contains("dock-active")) {
          e.preventDefault();
        }
      });
    });
  });
</script>
