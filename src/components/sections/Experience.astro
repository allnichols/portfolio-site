---
const experience = [
  {
    date: "Jan 2023 - May 2025",
    title: "Senior Front End Engineer",
    place: "Acuity Inc",
    description: `Led front-end development of a secure, Dropbox-style application supporting casework against child exploitation. Partnered with cross-functional teams to deliver impactful features, built modular UI components with Storybook to ensure consistency and reduce bugs, and implemented a scalable GraphQL/Apollo Client data layer for seamless client-server communication.`,
  },
  {
    date: "Jan 2022 - Dec 2022",
    title: "Senior Full Stack Developer",
    place: "Capgemini",
    description: `Built a serverless email notification system with Node.js and Amazon SES for scalable automation. Improved reliability and user experience by redesigning Yum! Brands’ password reset workflow for tens of thousands of employees. Migrated a legacy Angular app to React and TypeScript, enhancing performance, usability, and maintainability.`,
  },
  {
    date: "Jun 2019 - Jan 2022",
    title: "Full Stack Developer",
    place: "Industrial Info Resources",
    description: `Automated client product updates with an Excel-to-CSV parser, reducing manual work from 6 hours to under 30 minutes. Independently built a CMS using the MERN stack, empowering analysts to efficiently manage content and products`,
  },
];
---

<span id="experience"></span>
<section>
  <div class="container">
    <h2 class="text-center text-3xl font-semibold mb-4">Experience</h2>
    <ul
      class="timeline timeline-snap-icon max-md:timeline-compact timeline-vertical"
    >
      {
        experience.map((e, i) => {
          const isEven = i % 2 == 0;
          const timeLineLocation = isEven ? "end" : "start";
          const textLocation = isEven ? "" : "md:text-end";
          return (
            <li>
              <div class="timeline-middle">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-5 w-5"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z"
                    clip-rule="evenodd"
                  />
                </svg>
              </div>
              <div
                class={`timeline-${timeLineLocation} timeline-box mb-10 ${textLocation} text-[16px]`}
              >
                <time class="font-mono italic">{e.date}</time>
                <div class="text-lg font-black">
                  {e.title} - {e.place}
                </div>
                <p>{e.description}</p>
              </div>
              <hr />
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
